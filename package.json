{
  "name": "oneimpact",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @oneimpact/mobile start",
    "dev:api": "pnpm --filter @oneimpact/api start:dev",
    "dev:admin": "pnpm --filter @oneimpact/admin dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "pnpm --filter @oneimpact/api db:setup",
    "setup": "pnpm install && pnpm db:up && pnpm db:setup",
    "dev:all": "turbo run dev --filter=@oneimpact/api --filter=@oneimpact/admin"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.10.11",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  }
}
