{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'One Impact: load skill oneimpact-context before coding. Rules in .claude/rules/. Plans in .claude/plans/. Log AI usage with /ai-log.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/validate-commit-msg.sh" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/protect-paths.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/format-on-edit.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx expo *)",
      "Bash(npx prisma *)",
      "Bash(bash scripts/dev/quality-check.sh *)",
      "Bash(docker compose *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git branch --show-current*)", "Bash(git rev-parse*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git commit * --no-verify*)"
    ]
  }
}
