NODE_ENV=development
PORT=3000
# Supabase: pooled (6543) for runtime, direct (5432) for migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oneimpact?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/oneimpact?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# Auth rate limiting: 10 requests per minute on /v1/auth/* in production.
# The e2e suite raises the limit through the environment instead of skipping
# the throttler, so the guard stays exercised.
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_MS=60000
CORS_ORIGINS=http://localhost:3001,http://localhost:8081,http://192.168.0.3:8081

# Simulated payment latency (payments.service.ts). ~800 ms in dev so the demo
# feels like a real gateway. Set to 0 in test/CI so the unit and e2e suites do
# not pay that wall-clock time on every approved payment.
PAYMENT_SIMULATION_DELAY_MS=800

# Supabase Storage (storage.service.ts), used to sign uploads for
# POST /v1/uploads/sign. All three are optional and only used TOGETHER: if
# any of them is missing, the endpoint falls back to a local, non-functional
# URL with `simulated: true` in the response instead of failing, so the demo
# never depends on a real Supabase Storage bucket being configured.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=change-me
# SUPABASE_STORAGE_BUCKET=project-media
