{
  "name": "@oneimpact/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@hookform/resolvers": "^5.2.2",
    "@oneimpact/api-client": "workspace:*",
    "@oneimpact/shared": "workspace:*",
    "@oneimpact/ui-tokens": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.15",
    "expo-blur": "*",
    "expo-constants": "*",
    "expo-font": "*",
    "expo-haptics": "*",
    "expo-image": "*",
    "expo-linear-gradient": "*",
    "expo-linking": "*",
    "expo-router": "*",
    "expo-secure-store": "*",
    "expo-splash-screen": "*",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "*",
    "expo-video": "*",
    "lucide-react-native": "^1.33.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.66.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "*",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.1",
    "fast-text-encoding": "^1.0.6",
    "jest": "^29.7.0",
    "jest-expo": "*",
    "msw": "^2.15.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "react-native-url-polyfill": "^4.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --passWithNoTests"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "\\.mjs$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|msw|@mswjs|rettime|until-async|outvariant|strict-event-emitter|headers-polyfill|is-node-process|@open-draft|@bundled-es-modules|tough-cookie))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
