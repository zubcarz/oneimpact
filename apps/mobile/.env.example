# For Expo Go on a physical device use your LAN IP (ipconfig -> IPv4), e.g. http://192.168.0.3:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Set to 1 to force the msw/native mock server (apps/mobile/src/api/msw) even
# when EXPO_PUBLIC_API_URL is set above. Leaving EXPO_PUBLIC_API_URL empty has
# the same effect and needs no flag.
EXPO_PUBLIC_USE_MSW=
