# Server-only base URL of the API (src/lib/env.ts). Read by the route handlers
# in src/app/api/auth/* and by the gateway in src/app/api/gateway/*. It is not
# prefixed with NEXT_PUBLIC_, so it never reaches the browser bundle and can
# point at an internal host in deployment.
API_URL=http://localhost:5000

# Fallback for API_URL when it is not set (src/lib/env.ts), and the only value
# the browser needs on its own: the direct PUT to Supabase Storage (phase 5),
# where the file goes from the browser to the signed URL without passing
# through the admin.
# For everything else the browser does NOT talk to the API directly: it calls
# /api/gateway/*, which adds the Authorization header by reading the httpOnly
# session cookie.
NEXT_PUBLIC_API_URL=http://localhost:5000
