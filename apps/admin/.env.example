# Server-only base URL of the API (src/lib/env.ts). Read by the route handlers
# in src/app/api/auth/* and by the gateway in src/app/api/gateway/*. It is not
# prefixed with NEXT_PUBLIC_, so it never reaches the browser bundle and can
# point at an internal host in deployment.
API_URL=http://localhost:5000

# Fallback for API_URL when it is not set (src/lib/env.ts), and the only value
# the browser needs on its own: the direct PUT to Supabase Storage (phase 5),
# where the file goes from the browser to the signed URL without passing
# through the admin.
# For everything else the browser does NOT talk to the API directly: it calls
# /api/gateway/*, which adds the Authorization header by reading the httpOnly
# session cookie.
NEXT_PUBLIC_API_URL=http://localhost:5000

# OPTIONAL. Public base URL of the storage bucket, used only to compose the URL
# of an uploaded image: `${NEXT_PUBLIC_SUPABASE_PUBLIC_URL}/${key}`, since
# `POST /v1/uploads/sign` returns the key but not the public URL.
# Without it -- and whenever the API answers `simulated: true`, which is the case
# in local and in CI because it has no Supabase credentials -- the upload stays
# simulated: no bytes are sent and the update is published without an image. To
# demo an update with an image in that situation, paste an absolute URL in the
# "URL de imagen" field of the publish form.
# NEXT_PUBLIC_SUPABASE_PUBLIC_URL=https://<project>.supabase.co/storage/v1/object/public/<bucket>
