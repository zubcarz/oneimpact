{
  "name": "@oneimpact/shared",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed-data": {
      "types": "./dist/seed-data.d.ts",
      "default": "./dist/seed-data.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "echo skip",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@oneimpact/config": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
